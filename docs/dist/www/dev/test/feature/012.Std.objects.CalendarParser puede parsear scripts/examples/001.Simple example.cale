en 2026/12/25 {
    a las 09:00am {
        <Ducharse> por 30min,
        <Desayunar> por 20min,
        <Meditar> por 15min
    }
}

// F003: Insertar bloque de tareas contiguas en minuto concreto basándose en variable para el minuto

en 2026/12/25 {
    al #despertar {
        <Ducharse> por 30min,
        <Desayunar> por 20min,
        <Meditar> por 15min
    }
}

// F004: Insertar bloque de tareas contiguas en minuto concreto basándose en variable resuelta para el minuto

en 2026/12/25 {
    al #despertar [=09:00am] {
        <Ducharse> por 30min,
        <Desayunar> por 20min,
        <Meditar> por 15min
    }
}

