.DialogPort {
    position: relative;
}

.DialogView {
    position: absolute;
    border: var(--border_dark_concept_2);
    margin: 2px;
    border-radius: 3pt;
    display: flex;
    flex-direction: row;
    align-items: stretch;
}

.DialogView .dialog_topbar {
    display: flex;
    flex-direction: row;
    border-bottom: var(--border_dark_concept_1);
    align-items: center;
    background-color: var(--grey75);
    color: black;
    user-select: none;
}
.DialogView .dialog_title {
    flex: 100;
    cursor: default;
    touch-action: none;
    align-self: stretch;
    overflow: hidden;
    display: flex;
}

.DialogView .dialog_title:active {
    cursor: grabbing;
}
.DialogView .dialog_title_text {
    display: flex;
    align-items: center;
    padding-left: 4px;
}
.DialogView .dialog_top_buttons {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 2px;
    gap: 2px;
}
.DialogView .dialog_top_button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 12px;
    min-height: 12px;
    padding: 3px;
    border: var(--border_dark_concept_1);
    border-radius: 3pt; /*50%;*/
    background-color: var(--grey95);
    cursor: pointer;
}
.DialogView .dialog_top_button:hover {
    box-shadow: var(--shadow_concept_1);
}
.DialogView .dialog_body {
    padding: var(--spacing_size_2);
    background-color: var(--grey98);
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: auto;
}
.DialogView .dialog_footer {
    background-color: var(--grey90);
    color: var(--grey0);
}
.DialogView .dialog_status_bar {
    display: flex;
    flex-direction: row;
    border-top: var(--border_dark_concept_1);
    font-size: var(--font_size_small_1);
}
.DialogView .dialog_status_item {
    flex: 1;
    padding: var(--spacing_size_1);
    white-space: nowrap;
}

.DialogView .dialog_status_bar > .dialog_status_item {
    border-right: var(--border_dark_concept_1);
}

.DialogView .dialog_status_bar > .dialog_status_item:first-child {
    border-left: none;
}
.DialogView .dialog_status_bar > .dialog_status_item:last-child {
    border-right: none;
}


.DialogView .dialog_box {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
}


.DialogView .dialog_border {
    position: relative;
}
.DialogView .dialog_border > div {
    position: absolute;
    top: 0px;
    bottom: 0px;
    left: 0px;
    right: 0px;
    background-color: blue;
}
.DialogView .dialog_border.top_border > div {
    height: 6px;
    top: -6px;
    cursor: n-resize;
}
.DialogView .dialog_border.bottom_border > div {
    height: 6px;
    bottom: -6px;
    cursor: s-resize;
}
.DialogView .dialog_border.left_border > div {
    width: 6px;
    left: -6px;
    cursor: w-resize;
}
.DialogView .dialog_border.right_border > div {
    width: 6px;
    right: -6px;
    cursor: e-resize;
}

.DialogView .dialog_corner {
    position: relative;
}
.DialogView .dialog_corner > div {
    position: absolute;
    top: 0px;
    bottom: 0px;
    left: 0px;
    right: 0px;
    width: 6px;
    height: 6px;
    background-color: red;
}
.DialogView .dialog_corner.top_left_corner > div {
    top: -6px;
    left: -6px;
    cursor: nw-resize;
}
.DialogView .dialog_corner.top_right_corner > div {
    top: -6px;
    right: -6px;
    cursor: ne-resize;
}
.DialogView .dialog_corner.bottom_left_corner > div {
    bottom: -6px;
    left: -6px;
    cursor: sw-resize;
}
.DialogView .dialog_corner.bottom_right_corner > div {
    bottom: -6px;
    right: -6px;
    cursor: se-resize;
}











.flex_column {
    display: flex;
    flex-direction: column;
}

.flex_row {
    display: flex;
    flex-direction: row;
}

.flex_1 {
    flex: 1 !important;
}
.flex_100 {
    flex: 100 !important;
}
.flex_type_dialog_border {
    flex: 0 0 0px;
}

