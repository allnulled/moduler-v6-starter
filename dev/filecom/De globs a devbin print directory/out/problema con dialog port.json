<div class="DialogView View" v-on:click="focusMe" :class="{
        is_maximized: $locals.isMaximized,
        is_minimized: $locals.isMinimized,
    }">
    <div class="flex_column flex_100">
        <div class="flex_type_dialog_border flex_row">
            <div class="flex_type_dialog_border">
                <div class="dialog_corner top_left_corner"><div
                    v-on:pointerdown="event => startResize(event, 'top+left')"
                    v-on:pointermove="event => moveResize(event, 'top+left')"
                    v-on:pointerup="event => stopResize(event, 'top+left')"
                    v-on:pointercancel="event => stopResize(event, 'top+left')"></div></div>
            </div>
            <div class="flex_100">
                <div class="dialog_border top_border"><div
                    v-on:pointerdown="event => startResize(event, 'top')"
                    v-on:pointermove="event => moveResize(event, 'top')"
                    v-on:pointerup="event => stopResize(event, 'top')"
                    v-on:pointercancel="event => stopResize(event, 'top')"></div></div>
            </div>
            <div class="flex_type_dialog_border">
                <div class="dialog_corner top_right_corner"><div
                    v-on:pointerdown="event => startResize(event, 'top+right')"
                    v-on:pointermove="event => moveResize(event, 'top+right')"
                    v-on:pointerup="event => stopResize(event, 'top+right')"
                    v-on:pointercancel="event => stopResize(event, 'top+right')"></div></div>
            </div>
        </div>
        <div class="flex_100 flex_row">
            <div class="flex_type_dialog_border">
                <div class="dialog_border left_border"><div
                    v-on:pointerdown="event => startResize(event, 'left')"
                    v-on:pointermove="event => moveResize(event, 'left')"
                    v-on:pointerup="event => stopResize(event, 'left')"
