                        </div>
                    </div>
                </div>
                <div class="dialog_body">
                    <DynamicView :view="thread" :args="{dialog:this}" />
                </div>
                <div class="dialog_footer">
                    <div class="dialog_status_bar">
                        <div class="dialog_status_item flex_100">This is a message.</div>
                        <div class="dialog_status_item">Another.</div>
                        <div class="dialog_status_item">And more.</div>
                    </div>
                </div>
            </div>
